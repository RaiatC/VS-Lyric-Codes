class LyricBox:

    def __init__(self, root, data):

        self.root = root

        self.text = data["text"]
        self.x = data["x"]
        self.y = float(data["y"])

        self.type_speed = data["type_speed"]

        self.window = tk.Toplevel(root)

        self.window.overrideredirect(True)
        self.window.attributes("-topmost", True)

        self.window.geometry(
            f"{BOX_W}x{BOX_H}+{self.x}+{int(self.y)}"
        )

        self.label = tk.Label(
            self.window,
            text="",
            font=FONT,
            bg=BG_COLOR,
            fg=FG_COLOR,
            wraplength=BOX_W - 50,
            justify="center"
        )

        self.label.pack(
            expand=True,
            fill="both"
        )

        self.index = 0
        self.type_text()

    def type_text(self):

        if self.index < len(self.text):

            self.index += 1

            self.label.config(
                text=self.text[:self.index]
            )

            self.window.after(
                self.type_speed,
                self.type_text
            )

    def move(self):

        self.y -= RISE_SPEED

        self.window.geometry(
            f"{BOX_W}x{BOX_H}+{self.x}+{int(self.y)}"
        )

    def destroy(self):

        try:
            self.window.destroy()
        except:
            pass

class Animation:

    def __init__(self, root):

        self.root = root

        self.boxes = []

        self.next_box = 0

        self.start_time = time.monotonic()

        self.update()

    def update(self):

        elapsed = time.monotonic() - self.start_time

        while (
            self.next_box < len(BOXES)
            and elapsed >= BOXES[self.next_box]["show_at"]
        ):

            data = BOXES[self.next_box]

            box = LyricBox(
                self.root,
                data
            )

            self.boxes.append(box)

            self.next_box += 1

        for box in self.boxes[:]:

            box.move()

            if box.y + BOX_H < 0:

                box.destroy()

                self.boxes.remove(box)

        self.root.after(
            16,
            self.update
        )

root = tk.Tk()

root.withdraw()

animation = Animation(root)

root.mainloop()
